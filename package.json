{
  "name": "@myarchitectai/mcp",
  "version": "0.1.2",
  "description": "Model Context Protocol (MCP) server for the MyArchitectAI API \u2014 rendering, editing, textures, atmosphere, animation, prompts, 4K/8K upscaling and balance.",
  "type": "module",
  "license": "MIT",
  "author": "MyArchitectAI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "myarchitectai",
    "architecture",
    "ai-rendering",
    "claude"
  ],
  "homepage": "https://www.myarchitectai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyArchitectAI/myarchitectai-api-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MyArchitectAI/myarchitectai-api-mcp/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp": "dist/index.js",
    "myarchitectai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:tag": "git tag \"v$npm_package_version\" && git push origin \"v$npm_package_version\"",
    "api:check": "node scripts/api-contract.mjs",
    "api:check:live": "node scripts/api-contract.mjs --live",
    "api:update": "node scripts/api-contract.mjs --update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
