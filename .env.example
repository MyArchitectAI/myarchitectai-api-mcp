# MyArchitectAI API key — required.
# Get one at https://portal.myarchitectai.com (sent as the `x-api-key` header).
MYARCHITECTAI_API_KEY=your-api-key-here

# Optional overrides (defaults shown).
# MYARCHITECTAI_BASE_URL=https://api.myarchitectai.com/v1
# MYARCHITECTAI_TIMEOUT_MS=120000
# MYARCHITECTAI_MAX_RETRIES=2

# QoL tools
# MYARCHITECTAI_DOWNLOAD_DIR=renders          # where save_image writes
# MYARCHITECTAI_MAX_PREVIEW_BYTES=5000000      # max bytes preview_image embeds inline
# MYARCHITECTAI_STATE_FILE=                    # optional path to persist generation history

# Hosted MCP connector (company Vercel project; separate from stdio configuration).
# Set only in Production after the account owner has selected the API-balance contract.
# MCP_BILLING_MODE=api-balance
# MCP_DEPLOYMENT_REVISION=0123456789abcdef0123456789abcdef01234567
# MCP_CANONICAL_RESOURCE=https://mcp.myarchitectai.com/mcp
# PORTAL_SUPABASE_URL=https://your-portal-project.supabase.co
# PORTAL_SUPABASE_SERVICE_ROLE_KEY=stored-in-company-secret-manager
# MCP_OAUTH_CLIENT_IDS=["registered-oauth-client-id"]
# MCP_PORTAL_KEY_BINDINGS={"00000000-0000-0000-0000-000000000001":1}
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=stored-in-company-secret-manager
# AWS_SECRET_ACCESS_KEY=stored-in-company-secret-manager
# AWS_SESSION_TOKEN=optional-session-token
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=stored-in-company-secret-manager
# MCP_HISTORY_KEY_SECRET=at-least-32-random-characters
# MCP_ALLOWED_HOSTS=["deployment-host.vercel.app"]
# MCP_ALLOWED_ORIGINS=["https://trusted-client.example"]
# OBS_HEALTH_TOKEN=stored-in-company-secret-manager
