# MyArchitectAI API key — required.
# Get one at https://portal.myarchitectai.com (sent as the `x-api-key` header).
MYARCHITECTAI_API_KEY=your-api-key-here

# Optional overrides (defaults shown).
# MYARCHITECTAI_BASE_URL=https://api.myarchitectai.com/v1
# MYARCHITECTAI_TIMEOUT_MS=120000
# MYARCHITECTAI_MAX_RETRIES=2

# QoL tools
# MYARCHITECTAI_DOWNLOAD_DIR=renders          # where save_image writes
# MYARCHITECTAI_MAX_PREVIEW_BYTES=5000000      # max bytes preview_image embeds inline
# MYARCHITECTAI_STATE_FILE=                    # optional path to persist generation history
